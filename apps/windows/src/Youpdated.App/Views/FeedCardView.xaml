<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Youpdated.App.Views.FeedCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Youpdated.App.Views"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    Tapped="OnTapped"
    KeyDown="OnKeyDown"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <UserControl.ContextFlyout>
        <MenuFlyout Opening="OnMenuOpening" />
    </UserControl.ContextFlyout>

    <Grid x:Name="Surface"
          Margin="0,0,0,8"
          CornerRadius="{StaticResource OverlayCornerRadius}"
          BorderThickness="1"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

        <Border x:Name="AccentEdge" Width="3" HorizontalAlignment="Left" CornerRadius="8,0,0,8"
                Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />

        <Grid x:Name="Full" Padding="16,14,16,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:IconView x:Name="CardIcon" Size="40" VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <!-- The version in tabular digits -->
                <TextBlock x:Name="LeadText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LineText" MaxLines="2" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="FooterText" Margin="0,2,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,6,0,0">
                <FontIcon x:Name="HighBell" Glyph="&#xEA8F;" FontSize="13" Visibility="Collapsed"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            </StackPanel>

            <StackPanel x:Name="Details" Grid.Row="1" Grid.ColumnSpan="3" Spacing="10" Margin="0,12,0,0" Visibility="Collapsed">
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <RichTextBlock x:Name="NotesText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <HyperlinkButton x:Name="FullNotesButton" x:Uid="CardFullNotes" HorizontalAlignment="Right" Click="OnFullNotes" />
                <StackPanel x:Name="AlsoNewPanel" Spacing="4">
                    <Border Height="1" Margin="0,0,0,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Uid="CardAlsoNew" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="AlsoNewList" Spacing="2" />
                </StackPanel>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenButton" Style="{StaticResource AccentButtonStyle}" Click="OnOpen">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="CardOpen" />
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReadButton" Grid.Column="1" Click="OnToggleRead" />
                    <local:PriorityMenu x:Name="PriorityPicker" Grid.Column="2" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Low priority and read items get one line -->
        <Grid x:Name="Compact" Padding="12,8,16,8" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:IconView x:Name="CompactIcon" Size="24" />
            <TextBlock x:Name="CompactName" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
            <TextBlock x:Name="CompactLead" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="CompactFooter" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Ellipse x:Name="CompactDot" Grid.Column="4" Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>
    </Grid>
</UserControl>
