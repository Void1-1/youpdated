<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Youpdated.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Youpdated.Core\Youpdated.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Shared contract fixtures -->
  <ItemGroup>
    <None Include="..\..\..\contract\v1\fixtures\**\*.json" LinkBase="contract\fixtures" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\shared\presentation-cases.json" Link="shared\presentation-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
